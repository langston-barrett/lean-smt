[smt] goal: x ≠ none ∧ e ≠ Except.error true
[smt] 
    query:
    (set-logic ALL)
    (declare-datatypes ((Except 2)) ((par (|ε| |α|) ((Except.error (Except.error.field1 |ε|)) (Except.ok (Except.ok.field1 |α|))))))
    (declare-const e (Except Bool Int))
    (assert (= e ((as Except.ok (Except Bool Int)) 2)))
    (declare-datatypes ((Option 1)) ((par (|α|) ((Option.none) (Option.some (Option.some.val |α|))))))
    (declare-const x (Option Int))
    (assert (= x ((as Option.some (Option Int)) 3)))
    (assert (not (and (distinct x (as Option.none (Option Int))) (distinct e ((as Except.error (Except Bool Int)) true)))))
    (check-sat)
